# Only public values may use the NEXT_PUBLIC_ prefix — anything with that prefix
# is compiled into the browser bundle and is readable by anyone.
#
# These are read at BUILD time, not runtime. In a container platform they must be
# passed as build args; setting them as runtime env vars will not change the
# client bundle.

# Browser -> API
NEXT_PUBLIC_API_URL=http://localhost:4100/api/v1

# Canonical site URL, used for sitemap and robots
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Razorpay publishable key id ONLY. The key secret and webhook secret belong to
# the backend and must never appear here.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Server-side rendering -> API. In production point this at the internal service
# address so the traffic never leaves the private network.
API_URL=http://127.0.0.1:4100/api/v1
